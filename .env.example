# PocketOga backend env — variable names only, never values or secrets.
# Copy to .env.local and fill in your own values. .env.local is gitignored.
# Meta API key for text, audio and photo reads.
META_API_KEY=
# Baseten key for the second-opinion re-read.
BASETEN_API_KEY=
# Baseten model for the second-opinion re-read.
BASETEN_MODEL=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ALLOWED_NUMBERS=
WHATSAPP_SUMMARY_TEMPLATE=
PORT=
WEBHOOK_PORT=
WEBHOOK_PUBLIC_ONLY=
DATA_DIR=
LEDGER_DB=
SHELF_API_URL=
SHELF_API_KEY=
SHELF_MODEL=
# Optional owner inbox for POST /feedback (forwarded as JSON, best-effort).
FEEDBACK_WEBHOOK_URL=
# Shared secret sent with each owner inbox forward.
FEEDBACK_WEBHOOK_SECRET=
# Daily model-call budget for the demo shop (default 40).
DAILY_CAP_DEMO=
# Daily model-call budget per real shop (default 200).
DAILY_CAP_SHOP=
# Daily model-call budget for the whole service (default 1500).
DAILY_CAP_SERVICE=
